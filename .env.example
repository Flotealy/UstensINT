# ============================
# UstensINT — Variables d'environnement
# ============================

# --- PostgreSQL ---
POSTGRES_USER=ustensint
POSTGRES_PASSWORD=ustensint
POSTGRES_DB=ustensint

# --- Backend (FastAPI) ---
USTENSINT_DATABASE_URL=postgresql+asyncpg://ustensint:ustensint@db:5432/ustensint
USTENSINT_JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
USTENSINT_JWT_ALGORITHM=HS256
USTENSINT_JWT_EXPIRATION_DAYS=7
USTENSINT_CORS_ORIGINS=["http://localhost:3000","http://localhost"]
USTENSINT_UPLOAD_DIR=/app/uploads
USTENSINT_MAX_UPLOAD_SIZE_MB=50
USTENSINT_ALLOWED_DOMAINS=telecom-sudparis.eu

# --- Serveur Mail SMTP (docker-mailserver) ---
SMTP_HOST=mail.florianriviere.com
SMTP_PORT=587
SMTP_USER=noreply@florianriviere.com
SMTP_PASSWORD=change-me-to-your-mail-password
SMTP_FROM=noreply@florianriviere.com
SMTP_TLS=true
